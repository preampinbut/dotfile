output "Microstep MSI MD2412P PA5HA55500292" {
  mode 1920x1080@99.999Hz
  alias $M_HOME
}

profile {
  output eDP-1 enable
    exec $HOME/.config/scripts/switch/lid_handler
}

profile {
  output eDP-1 disable
  output $M_HOME enable
}

# fallback
profile {
  output eDP-1 disable
  output HDMI-A-1 enable
}
