/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    bg0:    #1e1e2eF2;
    bg1:    #1e1e2e;
    bg2:    #3D3D3D;
    bg3:    #f5c2e7;
    fg0:    #f5c2e7;
    fg1:    #f5c2e7;
    fg2:    #969696;
    fg3:    #3D3D3D;
}

configuration {
	icon-theme:                     "Catppuccin-Mocha";
  drun-display-format:            "{name}";
  disable-history:                false;
  fullscreen:                     false;
	hide-scrollbar:                 true;
	sidebar-mode:                   false;
}

@import "template/powermenu-rounded-template.rasi"
